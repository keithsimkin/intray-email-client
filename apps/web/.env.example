DODO_PAYMENTS_API_KEY=dodo_live_...
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_RETURN_URL=https://intray.site/thanks
# Signing secret from GET /webhooks/{id}/secret (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
DODO_PRODUCT_MONTHLY=pdt_...
DODO_PRODUCT_ONCE=pdt_...

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM=Intray <hello@intray.site>
RESEND_SUPPORT_TO=you@intray.site

# AppSumo lifetime licenses. Ed25519 PKCS#8 PEM private key.
# Paste the PEM (including BEGIN/END lines) or the base64 encoding of that PEM.
# Newlines may be real line breaks or \n escapes. If this is missing or not a
# valid Ed25519 key, POST /api/redeem returns 503.
# LICENSE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

