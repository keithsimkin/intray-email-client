{
  "name": "@intray/desktop",
  "private": true,
  "version": "0.1.5",
  "description": "Intray — unified mail for Windows and macOS",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/keithsimkin/intray-email-client.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --x64 --publish never",
    "pack:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "pack:mac": "electron-vite build && electron-builder --mac --arm64 --publish never",
    "release": "electron-vite build && electron-builder --win --x64 --publish always",
    "release:win": "electron-vite build && electron-builder --win --x64 --publish always",
    "release:mac": "electron-vite build && electron-builder --mac --arm64 --publish always",
    "test": "bun test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@intray/native": "workspace:*",
    "electron-updater": "^6.8.11",
    "imapflow": "^2.12.1",
    "lucide-react": "^0.525.0",
    "mailparser": "^3.14.5",
    "nodemailer": "^10.6.0",
    "pdfjs-dist": "4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-icons": "^16.38.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
