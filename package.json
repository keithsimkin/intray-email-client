{
  "name": "intray",
  "private": true,
  "version": "0.1.5",
  "workspaces": ["apps/*", "crates/intray-native"],
  "scripts": {
    "dev:web": "bun --filter @intray/web dev",
    "dev:desktop": "bun run build:native && bun --filter @intray/desktop dev",
    "build:web": "bun --filter @intray/web build",
    "build:native": "bun --filter @intray/native build",
    "build:desktop": "bun run build:native && bun --filter @intray/desktop build",
    "pack:desktop": "bun run build:native && bun --filter @intray/desktop pack",
    "pack:desktop:win": "bun run build:native && bun --filter @intray/desktop pack:win",
    "pack:desktop:mac": "bun run build:native && bun --filter @intray/desktop pack:mac",
    "release:desktop": "bun run build:native && bun --filter @intray/desktop release",
    "release:desktop:win": "bun run build:native && bun --filter @intray/desktop release:win",
    "release:desktop:mac": "bun run build:native && bun --filter @intray/desktop release:mac"
  },
  "packageManager": "bun@1.4.2"
}
